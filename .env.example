# MongoDB Connection String (Đổi sang Atlas connection string nếu dùng Cloud)
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.1rl5eeo.mongodb.net/?appName=Cluster0
DB_NAME=medispace_db
PATIENTS_COLLECTION=patients
RECORDS_COLLECTION=medical_records

# Backend Configuration
# development: .env được ưu tiên; production: biến môi trường OS được ưu tiên
APP_ENV=development
# Mặc định chỉ nghe localhost; đổi 0.0.0.0 nếu thực sự cần truy cập từ máy khác
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
# Các origin được phép gọi API từ trình duyệt (phân tách bằng dấu phẩy)
CORS_ORIGINS=http://localhost:8501,http://127.0.0.1:8501

# Frontend Configuration
API_BASE_URL=http://localhost:8000/api/v1
